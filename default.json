{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "renovate/chore/",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:monorepos",
    "group:recommended",
    "mergeConfidence:all-badges"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions updates"
    },
    {
      "description": "Group identical packages across all files",
      "matchPackageNames": ["*"],
      "groupName": "{{{depName}}}"
    },
    {
      "enabled": false,
      "matchPackageNames": ["/ghcr.io/spigell/*/"]
    },
    {
      "description": "Don't update golang in FROM lines, we use ARG instead",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "enabled": false
    },
    {
      "matchPackageNames": ["python"],
      "allowedVersions": "< 3.14.0",
      "automerge": false
    },
    {
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "<25"
    },
    {
      "description": "Keep the Pulumi CLI on the manually approved version",
      "matchDepNames": ["pulumi/pulumi", "@pulumi/pulumi"],
      "allowedVersions": "<=3.236.0"
    }
  ]
}
