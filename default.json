{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "renovate/chore/",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:monorepos",
    "group:recommended",
    "mergeConfidence:all-badges"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions updates"
    },
    {
      "description": "Group identical packages across all files",
      "matchPackageNames": ["*"],
      "groupName": "{{{depName}}}"
    },
    {
      "description": "Don't update golang in FROM lines, we use ARG instead",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "enabled": false
    },
    {
      "matchPackageNames": ["python"],
      "allowedVersions": "< 3.14.0",
      "automerge": false
    },
    {
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "<25"
    },
    {
      "description": "Keep the Pulumi CLI, workbench image and core SDKs (Go, npm, Python) on the manually approved version 3.267.0, already merged in pulumi-talos-cluster; source: https://github.com/spigell/pulumi-talos-cluster/pull/63; review after: 2026-11-02",
      "matchDepNames": [
        "pulumi/pulumi",
        "@pulumi/pulumi",
        "ghcr.io/spigell/pulumi-workbench",
        "github.com/pulumi/pulumi/sdk/v3",
        "github.com/pulumi/pulumi/pkg/v3",
        "pulumi"
      ],
      "allowedVersions": "<=3.267.0"
    },
    {
      "description": "my-cloud-resume runs TypeScript through ts-node, which has no TypeScript 7 compiler API; the repositories that already moved to TypeScript 7 keep getting its updates; source: https://github.com/spigell/my-cloud-resume/pull/58; review after: 2026-11-02",
      "matchRepositories": ["spigell/my-cloud-resume", "spigell/pulumi-talos-cluster", "spigell/my-nodejs-libs"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
